# CareGrid — environment template
# Copy to .env.local and paste your Anthropic API key.
# The key is read server-side only (app/api/agent/route.ts) and never exposed to the browser.
# If absent, the app falls back to a deterministic precomputed session so the demo never breaks.
ANTHROPIC_API_KEY=

# Set to 1 to force deterministic mode: the engine always returns the same fixed
# result (identical visuals), ideal for recording a reproducible demo video.
CAREGRID_DETERMINISTIC=0
